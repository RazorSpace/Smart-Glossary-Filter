{
  "manifest_version": 3,
  "name": "Smart Glossary Filler",
  "version": "1.4.0",
  "description": "Capture glossary terms, map them to Google Sheets columns, deduplicate and fill them in automatically. 100% local.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "alarms",
    "debugger"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://accounts.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "action": {
    "default_title": "Open Glossary Dashboard",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}